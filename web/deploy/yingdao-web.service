[Unit]
Description=Yingdao web migration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yingdao-web
Group=yingdao-web
WorkingDirectory=/opt/yingdao-web
ExecStart=/opt/yingdao-web/bin/yingdao-web
Environment=YINGDAO_BIND_ADDR=127.0.0.1:18080
Environment=YINGDAO_STATIC_DIR=/opt/yingdao-web/public
Environment=YINGDAO_DATABASE_PATH=/var/lib/yingdao-web/yingdao-web.sqlite3
Environment=YINGDAO_ACCOUNT_KEY_PATH=/var/lib/yingdao-web/account.key
Environment=YINGDAO_TEMP_DIR=/var/lib/yingdao-web/tmp
Environment=YINGDAO_COOKIE_SECURE=true
EnvironmentFile=-/etc/yingdao-web.env
Environment=RUST_LOG=yingdao_web=info,tower_http=info
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yingdao-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
